# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgres://pesamatters:replace-with-a-long-random-password@127.0.0.1:5433/pesamatters
# Dev-only password applied to seeded crew accounts on first `npm run db:seed`.
SEED_PASSWORD=replace-with-at-least-10-chars
# First desk sign-in. Used only when the admins table is empty during seed. Leave both unset to skip.
# DESK_EMAIL=desk@hackstreet.local
# DESK_PASSWORD=replace-with-at-least-10-chars
COOKIE_SECURE=false
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
# Web OAuth client from Google Cloud. Leave unset until you have both.
# Redirect URI must be exactly http://127.0.0.1:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Upstash Redis (sign-in rate limit). Leave unset for local in-memory fallback.
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron shared secret. Required in production for /api/cron/closes.
# CRON_SECRET=replace-with-a-long-random-secret

# Daraja. mock settles Add and Out locally. live needs the Safaricom app's own key.
MPESA_MODE=mock
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-host/api/payments/mpesa/stk
# Withdrawals (Out) also need B2C. Leave unset until that shortcode is ready.
# MPESA_INITIATOR_NAME=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_B2C_SHORTCODE=
# MPESA_B2C_RESULT_URL=https://your-host/api/payments/mpesa/b2c
# MPESA_B2C_TIMEOUT_URL=https://your-host/api/payments/mpesa/b2c-timeout
