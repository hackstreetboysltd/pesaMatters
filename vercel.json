{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "redirects": [
    { "source": "/desk", "destination": "/admin", "permanent": false },
    { "source": "/desk/login", "destination": "/admin/login", "permanent": false },
    { "source": "/desk/queue", "destination": "/admin/loans", "permanent": false },
    { "source": "/desk/you", "destination": "/admin", "permanent": false },
    { "source": "/desk/work/:id", "destination": "/admin/loans/:id", "permanent": false },
    { "source": "/desk/work", "destination": "/admin/loans", "permanent": false },
    { "source": "/desk/:path*", "destination": "/admin", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/((?!api/|admin\\.html|assets/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/closes",
      "schedule": "1 21 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{server/data/**,server/sql/**}"
    }
  }
}
